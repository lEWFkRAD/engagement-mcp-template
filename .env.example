# Copy to .env (gitignored) or set in your MCP client's env block.
# Absolute path to the engagement root folder (holds plan/ontology/ontology.json).
ENGAGEMENT_ROOT=C:/path/to/your-engagement-root

# internal (default) shows everything; shared hides internal-marked nodes/docs.
ENGAGEMENT_AUDIENCE=internal

# Set to 1 to enable the single write tool (log_document -> local intake ledger).
# ENGAGEMENT_ALLOW_WRITE=1
